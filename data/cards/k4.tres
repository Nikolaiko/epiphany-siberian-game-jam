[ext_resource type="Script" uid="uid://cl5iyhsddn73a" path="res://data/card_data.gd" id="1_card_data"]

[resource]
script = ExtResource("1_card_data")
id = &"k4"
myth_text = "Это была огромная битва, десятки тысяч воинов"
fact_text = "Летопись: 400 немцев убито, 50 в плену. Немецкая хроника: 20 рыцарей убито, 6 в плену. Историки оценивают войска от сотен до нескольких тысяч человек"
source = "Новгородская первая летопись, 1242 год; Старшая Ливонская рифмованная хроника; оценки И. Н. Данилевского и Д. Г. Хрусталёва."
metadata/_custom_type_script = "uid://cl5iyhsddn73a"
