id = &"k4"
myth_text = "Это была огромная битва, десятки тысяч воинов"
fact_text = "Летопись: 400 немцев убито, 50 в плену. Немецкая хроника: 20 рыцарей убито, 6 в плену. Историки оценивают войска от сотен до нескольких тысяч человек"
