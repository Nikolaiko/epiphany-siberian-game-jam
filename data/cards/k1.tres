script = ExtResource("1_vcwrc")
id = &"k1"
myth_text = "Мы победили, потому что были едины"
fact_text = "Единство пришлось собирать: в 1240 году Новгород выгнал Александра, Псков сдали немцам свои же бояре, за Орден воевал русский князь"
source = "Новгородская первая летопись, 1240–1242 годы"
