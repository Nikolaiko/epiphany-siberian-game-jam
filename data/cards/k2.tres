script = ExtResource("1_p5c7t")
id = &"k2"
myth_text = "У немцев были тяжёлые доспехи, а у наших — лёгкие"
fact_text = "В 1242 году у обеих сторон кольчуга, шлем и щит. Сплошные латы появятся через 100–200 лет"
source = "А. Н. Кирпичников, «Древнерусское оружие»"
