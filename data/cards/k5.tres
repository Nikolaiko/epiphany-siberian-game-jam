id = &"k5"
myth_text = "Невский сказал: «Кто с мечом к нам придёт, от меча и погибнет»"
fact_text = "Фразу написали для фильма 1938 года. Слова из Жития: «Не в силе Бог, но в правде»"
source = "«Повесть о житии Александра Невского» (1280-е годы); фильм «Александр Невский» (1938)."
