id = &"k3"
myth_text = "Немцы провалились под лёд и утонули"
fact_text = "Ни русская летопись, ни немецкая хроника, ни Житие этого не пишут. Тонущих рыцарей прославил фильм 1938 года"
source = "Новгородская первая летопись, 1242 год; Старшая Ливонская рифмованная хроника."
